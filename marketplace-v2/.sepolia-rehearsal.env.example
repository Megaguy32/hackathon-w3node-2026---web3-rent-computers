# Copy to .sepolia-rehearsal.env (git-ignored) and fill in. Use THROWAWAY keys only.
# Never paste these values into chat; just tell Claude the file exists.

# Any Sepolia JSON-RPC endpoint (public ones work, e.g. https://ethereum-sepolia-rpc.publicnode.com)
SEPOLIA_RPC_URL=

# Deploys the contract. Needs ~0.01 Sepolia ETH.
PRIVATE_KEY=

# Registers the demo listing (must differ from the MetaMask consumer account).
# Needs a little gas.
PROVIDER_PRIVATE_KEY=

# PUBLIC address of the MetaMask account that will click Rent (no key needed).
CONSUMER_ADDRESS=

# Keep rehearsal cost low.
LISTING_PRICE_WEI=1000000000000000   # 0.001 ETH
LISTING_DURATION_SECONDS=3600
