# Everything on ONE Linux laptop: Minikube (KVM2) consumer + compose pool host + provider VMs.
# Copy to .demo-laptop.env. Paths use $HOME so no editing is needed unless you want different locations.
MINIKUBE_PROFILE=w3node-demo
MINIKUBE_DRIVER=kvm2
MINIKUBE_CPUS=2
MINIKUBE_MEMORY=4096
MINIKUBE_DISK_SIZE=20g
INTERLINK_DIR=$HOME/src/interLink
KUBECONFIG=$HOME/.kube/config
DEMO_STATE_DIR=$HOME/.local/state/w3node

# The compose "sshd" service stands in for the pool host's sshd; demo-up.sh generates this key and host key.
MARKETPLACE_SSH_ADDR=127.0.0.1:2222
MARKETPLACE_SSH_USER=interlink-tunnel
SSH_KEY=$HOME/.local/state/w3node/tunnel/tunnel
SSH_HOST_KEY_FILE=$HOME/.local/state/w3node/tunnel/hostkeys/hostkey.txt
PLUGIN_PORT=4000
PLUGIN_LOCAL_PORT=4001

# Address provider VMs use to reach the pool: the libvirt "default" network gateway (usually this).
POOL_HOSTNAME=192.168.122.1
PROVIDER_VM_NAME=w3node-provider
GRAFANA_ADMIN_PASSWORD=change-me

# Prometheus scrape targets for the Grafana CPU/RAM panels (re-run `./scripts/demo-laptop.sh monitoring` after changing):
#   host exporter on the Minikube bridge (see: virsh net-dumpxml mk-w3node-demo | grep "ip address"), provider VM IPs
#   (./scripts/demo-laptop.sh provider-ip), and the marketplace metrics endpoint on the same bridge address.
PROVIDER_METRICS_TARGETS=192.168.39.1:9100
MARKETPLACE_METRICS_TARGET=192.168.39.1:9101
