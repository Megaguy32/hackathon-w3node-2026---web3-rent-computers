# Ethereum Sepolia JSON-RPC endpoint (Alchemy, Infura, self-hosted, etc.). Keep private.
RPC_URL=
CHAIN_ID=11155111
CONTRACT_ADDRESS=
# Start block of the deployed contract. If 0, listener starts at current head;
# start the backend before creating the first listing.
START_BLOCK=0

LISTEN_ADDR=127.0.0.1:8080
HTCONDOR_STATUS=condor_status
DATA_DIR=/var/lib/w3node-compute-marketplace
RENTALS_FILE=/run/w3node/rentals.json
CHAIN_POLL_SECONDS=5

# The plugin service sets MEGA_RENTALS_FILE itself and deliberately does not
# read this file (it contains RPC credentials).

# Optional: serve Prometheus /metrics (compute fleet counters) on a separate address, e.g. the Minikube bridge IP:9101.
# Leave empty to disable. Never expose it publicly; it is not on the UI listener.
METRICS_ADDR=

# Blocks the chain watcher stays behind the head (default 3 ~ 36 s on Sepolia). Use 1 for a live demo.
CONFIRMATIONS=3
