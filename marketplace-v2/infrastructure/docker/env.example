# infrastructure/docker/.env (git-ignored). scripts/demo-up.sh generates it from .sepolia-rehearsal.env if missing.
# Non-secret values only; never put private keys here.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
START_BLOCK=0
CONFIRMATIONS=1
POOL_HOSTNAME=192.168.122.1      # address providers use to reach this host (libvirt default gateway)
POOL_MACHINE_NAME=my-laptop      # HTCondor Machine name of the local provider; list this name on-chain
POOL_RUN_STARTD=true
