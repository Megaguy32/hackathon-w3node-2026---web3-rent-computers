# Copy this file to .demo-laptop.env and fill in the values.
# This configures the laptop-side consumer cluster and its connection to the
# remote Marketplace / HTCondor pool host.

MINIKUBE_PROFILE=w3node-demo
MINIKUBE_CPUS=4
MINIKUBE_MEMORY=8192
MINIKUBE_DISK_SIZE=30g
MINIKUBE_DRIVER=kvm2

# Where the official interLink repository will be cloned and built.
INTERLINK_DIR=$HOME/src/interLink
INTERLINK_REF=main

# SSH endpoint for the marketplace host where interlink-htcondor-plugin runs.
MARKETPLACE_SSH_ADDR=pool.example.net:22
MARKETPLACE_SSH_USER=interlink-tunnel
SSH_KEY=$HOME/.ssh/interlink_rsa
# Strongly recommended. Leave blank only for a controlled local rehearsal.
SSH_HOST_KEY_FILE=$HOME/.ssh/interlink_host_key

# How the interLink API reaches the remote plugin: local-forward (ssh -L, default) or
# interlink-ssh-tunnel (upstream bin/ssh-tunnel; verify its direction first).
TUNNEL_MODE=local-forward

# Optional local provider VM. This guest joins the REMOTE pool using CCB.
# The remote pool firewall must allow the laptop's public egress IP on TCP/9618.
POOL_HOSTNAME=pool.example.net
PROVIDER_VM_NAME=w3node-provider
PROVIDER_VM_CPUS=4
PROVIDER_VM_MEMORY=4096
PROVIDER_VM_DISK_SIZE=25G
PROVIDER_VM_DIR=/var/lib/libvirt/images/w3node
PROVIDER_VM_USER=demo
UBUNTU_CLOUD_IMAGE_URL=https://cloud-images.ubuntu.com/resolute/current/resolute-server-cloudimg-amd64.img

# Optional marketplace UI SSH forward (remote app listens on 127.0.0.1:8080).
MARKETPLACE_UI_LOCAL_PORT=8080

# Optional Prometheus/Grafana add-on for the local Minikube cluster.
GRAFANA_ADMIN_PASSWORD=w3node-demo
GRAFANA_LOCAL_PORT=3000
